{
  "name": "vocalcoach-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "type-check": "tsc --noEmit",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "deps:check": "node scripts/check-dependencies.js",
    "deps:install": "npm install",
    "deps:update": "npm update",
    "deps:clean": "rm -rf node_modules package-lock.json && npm install",
    "audit:performance": "node scripts/performance-audit.js",
    "audit:ci": "cross-env CI=true npm run audit:performance",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "analyze:bundle:ci": "cross-env CI=true npm run analyze:bundle",
    "audit:accessibility": "node scripts/accessibility-audit.js",
    "audit:accessibility:ci": "cross-env CI=true npm run audit:accessibility",
    "test:load": "node scripts/load-test.js",
    "test:load:ci": "cross-env CI=true npm run test:load",
    "beta:setup": "node scripts/setup-beta.js",
    "beta:setup:ci": "cross-env CI=true npm run beta:setup",
    "beta:send-invites": "node scripts/send-beta-invites.js",
    "beta:send-invites:ci": "cross-env CI=true npm run beta:send-invites",
    "beta:monitor": "node scripts/monitor-health.js",
    "beta:monitor:ci": "NODE_ENV=ci node scripts/monitor-health.js",
    "beta:monitor:background": "node scripts/monitor-health.js &",
    "beta:report": "node scripts/generate-beta-report.js",
    "beta:report:ci": "cross-env CI=true npm run beta:report",
    "beta:report:daily": "node scripts/generate-beta-report.js --daily",
    "beta:report:weekly": "node scripts/generate-beta-report.js --weekly",
    "beta:schedule-reports": "node scripts/schedule-beta-reports.js",
    "beta:schedule-reports:ci": "cross-env CI=true npm run beta:schedule-reports",
    "beta:backup": "node scripts/backup-beta.js",
    "beta:backup:ci": "cross-env CI=true npm run beta:backup",
    "beta:backup:daily": "node scripts/backup-beta.js --daily",
    "beta:verify-db": "node scripts/verify-mongodb.js",
    "beta:verify-db:ci": "cross-env CI=true npm run beta:verify-db",
    "beta:validate-email": "node scripts/validate-email.js",
    "beta:validate-email:ci": "NODE_ENV=ci node scripts/validate-email.js",
    "beta:setup-gmail": "node scripts/setup-gmail.js",
    "beta:setup-gmail:ci": "NODE_ENV=ci node scripts/setup-gmail.js",
    "beta:backup-db": "node scripts/backup-mongodb.js",
    "beta:backup-db:ci": "NODE_ENV=ci node scripts/backup-mongodb.js",
    "beta:backup-db:schedule": "node -e \"setInterval(() => require('./scripts/backup-mongodb.js'), 24 * 60 * 60 * 1000)\"",
    "beta:setup-dns": "node scripts/setup-email-dns.js generate",
    "beta:verify-dns": "node scripts/setup-email-dns.js verify",
    "beta:setup-dns:ci": "NODE_ENV=ci npm run beta:setup-dns",
    "beta:test-restore": "node scripts/test-restore.js",
    "beta:test-discord": "node scripts/discord-alerts.js test",
    "beta:test-discord:ci": "NODE_ENV=ci npm run beta:test-discord",
    "beta:setup-staging": "node scripts/setup-staging.js",
    "beta:backup-staging": "node scripts/backup-mongodb.js --db vocalcoach_staging",
    "beta:install-tools": "powershell -ExecutionPolicy Bypass -File scripts/install-mongodb-tools.ps1",
    "beta:verify-tools": ".\\tools\\mongodb\\mongodb-database-tools-windows-x86_64-100.9.4\\bin\\mongodump.exe --version && .\\tools\\mongodb\\mongodb-database-tools-windows-x86_64-100.9.4\\bin\\mongorestore.exe --version",
    "beta:configure-dns": "node scripts/setup-dns-provider.js",
    "beta:monitor-health": "node scripts/monitor-health.js",
    "beta:setup-webhooks": "node scripts/setup-discord-webhooks.js",
    "beta:setup-webhooks:ci": "cross-env CI=true npm run beta:setup-webhooks",
    "beta:dashboard": "node scripts/dashboard-monitor.js",
    "beta:dashboard:ci": "cross-env CI=true npm run beta:dashboard",
    "beta:backup:list": "node scripts/backup-mongodb.js --list",
    "beta:backup:restore": "node scripts/test-restore.js",
    "beta:backup:verify": "node scripts/verify-backup.js",
    "beta:progress": "node scripts/generate-beta-progress.js",
    "beta:checklist": "node scripts/checklist-progress.js",
    "beta:checklist:update": "node scripts/checklist-progress.js --update",
    "beta:ai-diagnosis": "node scripts/ai-quick-diagnosis.js",
    "test:server": "node scripts/test-server.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:backend:simple": "cd backend && npm run dev:simple",
    "build:backend": "cd backend && npm run build",
    "start:backend": "cd backend && npm start",
    "monitor:dns": "node scripts/monitor-dns.js",
    "monitor:test": "node scripts/test-discord.js",
    "monitor:build": "tsc -p tsconfig.monitor.json",
    "monitor:watch": "tsc -p tsconfig.monitor.json --watch",
    "monitor:health": "node scripts/monitor-health.js",
    "backup:create": "node scripts/backup-mongodb.js",
    "backup:restore": "node scripts/verify-backup.js",
    "deploy:staging": "npm run build && npm run test",
    "deploy:prod": "npm run build && npm run test:e2e"
  },
